# Local test binding: a one-validator localnet on a laptop, brought up with
#   ./localnet/localnet.sh bootstrap
#
# Worth having as a worked example because it exercises the OTHER ledger read
# path: the bind mount is owned by the user who started the stack, so the CLI
# reads the SQLite file directly and no docker exec is involved.

DN_AGENT=local-researcher
DN_ROLE=research
DN_RUNNER=claude
DN_NODE=node-a
DN_REPO=/Users/abuzark/Dev/discovery_net
DN_CHAIN_ID=discovery-local-1

DN_RPC_URL=http://127.0.0.1:26657
DN_GRAPHQL_CMD='/Users/abuzark/Dev/discovery_net/.venv/bin/discovery-net graphql --ledger-path /Users/abuzark/Dev/discovery_net/run/discovery-demo/node-a/ledger-data/artifact-ledger.sqlite'
DN_SUBMIT_CMD='/Users/abuzark/Dev/discovery_net/.venv/bin/discovery-net submit contribution --rpc-url http://127.0.0.1:26657 --private-key /Users/abuzark/Dev/discovery_net/run/agents/local-researcher/contributor.pem'

DN_KEY_PATH=/Users/abuzark/Dev/discovery_net/run/agents/local-researcher/contributor.pem
DN_WORKLOG=/Users/abuzark/Dev/discovery_net/run/agents/local-researcher/worklog.md
DN_CLAIMS_DIR=/Users/abuzark/Dev/discovery_net/run/agents/claims.d
DN_NOTES_CLONE=/Users/abuzark/Dev/discovery-net-notes

# Example only — generate real ones with agent-sessions/init-node.sh.
# Shape B: a localnet started by this account, so the CLI reads the SQLite file
# directly and no container is involved. This is the local-testing shape.

DN_NODE=node-a
DN_CHAIN_ID=discovery-local-1
DN_RPC_URL=http://127.0.0.1:26657
DN_GRAPHQL_CMD='/home/you/dev/discovery_net/.venv/bin/discovery-net graphql --ledger-path /home/you/dev/discovery_net/run/discovery-demo/node-a/ledger-data/artifact-ledger.sqlite'
DN_SUBMIT_BASE='/home/you/dev/discovery_net/.venv/bin/discovery-net submit contribution --rpc-url http://127.0.0.1:26657'

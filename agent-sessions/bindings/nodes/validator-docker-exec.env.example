# Example only — generate real ones with agent-setup/init-node.sh.
# Real bindings live OUTSIDE the checkout, under ~/.config/discovery-net/bindings/
# (DN_CONFIG_ROOT/bindings on a host), never here.
# Shape A: the ledger bind mount is root-owned, so reads go through the node's
# own application container.

DN_NODE=node-abu-1
DN_CHAIN_ID=discovery-net
DN_RPC_URL=http://127.0.0.1:26657
DN_GRAPHQL_CMD='docker exec discovery-node-abu-1-application-1 discovery-net graphql --ledger-path /var/lib/discovery-net/artifact-ledger.sqlite'
DN_SUBMIT_BASE='/home/you/dev/discovery_net/.venv/bin/discovery-net submit contribution --rpc-url http://127.0.0.1:26657'

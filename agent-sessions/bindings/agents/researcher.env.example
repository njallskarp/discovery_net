# Example only — generate real ones with agent-setup/init-agent.sh.
# Real bindings live OUTSIDE the checkout, under ~/.config/discovery-net/bindings/
# (DN_CONFIG_ROOT/bindings on a host), never here.
# Agent facts only. Node facts come from the file named by DN_NODE_BINDING.

DN_AGENT=researcher-1
DN_ROLE=research
DN_RUNNER=claude
DN_NODE_BINDING=node-abu-1

DN_KEY_PATH=/home/you/agent-sessions/researcher-1/contributor.pem
DN_WORKLOG=/home/you/agent-sessions/researcher-1/worklog.md
DN_CLAIMS_DIR=/home/you/agent-sessions/claims.d
DN_NOTES_CLONE=/home/you/agent-sessions/researcher-1/discovery-net-notes

# Optional. Unset means the runner's own default model, which is what the cost
# figures in runs.jsonl were measured on. Set it to run this agent cheaper than
# the rest of the fleet; the reviewer is the one to think twice about.
# DN_MODEL=

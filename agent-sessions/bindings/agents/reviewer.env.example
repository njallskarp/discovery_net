# Example only — generate real ones with agent-setup/init-agent.sh.
# Real bindings live OUTSIDE the checkout, under ~/.config/discovery-net/bindings/
# (DN_CONFIG_ROOT/bindings on a host), never here.

DN_AGENT=reviewer
DN_ROLE=review
DN_RUNNER=codex
DN_NODE_BINDING=node-abu-1

DN_KEY_PATH=/home/you/agent-sessions/reviewer/contributor.pem
DN_WORKLOG=/home/you/agent-sessions/reviewer/worklog.md
DN_CLAIMS_DIR=/home/you/agent-sessions/claims.d
DN_NOTES_CLONE=/home/you/agent-sessions/reviewer/discovery-net-notes
DN_REVIEWED=/home/you/agent-sessions/reviewer/reviewed.jsonl

COMPOSE_PROJECT_NAME=discovery-node-cloud-1
DISCOVERY_NET_IMAGE=discovery-net-node:cloud
DISCOVERY_NET_UID=10001
DISCOVERY_NET_GID=10001

NODE_NAME=discovery-node-cloud-1
CHAIN_ID=discovery-local-1
GENESIS_FILE=/srv/discovery-net/genesis.json
GENESIS_SHA256=replace-with-trusted-sha256

COMETBFT_DATA_DIRECTORY=/srv/discovery-net/cometbft-data
LEDGER_DATA_DIRECTORY=/srv/discovery-net/ledger-data
CADDY_DATA_DIRECTORY=/srv/discovery-net/caddy-data
CADDY_CONFIG_DIRECTORY=/srv/discovery-net/caddy-config

P2P_NETWORK=discovery-net-p2p
P2P_ALIAS=discovery-node-cloud-1
P2P_ADVERTISED_ENDPOINT=203.0.113.30:26656
PERSISTENT_PEERS=node-id-a@203.0.113.10:26656,node-id-f@198.51.100.20:26656

RPC_PORT=26657
INSPECTOR_HOSTNAME=inspector.example.com
ACME_EMAIL=operator@example.com

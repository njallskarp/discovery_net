#!/usr/bin/env bash
set -euo pipefail

# Terraform replaces data_device_name before execution.
# shellcheck disable=SC2154
readonly DATA_DEVICE="/dev/disk/by-id/google-${data_device_name}"
readonly DATA_MOUNT="/srv/discovery-net"
readonly SERVICE_UID="10001"
readonly SERVICE_GID="10001"
readonly BOOTSTRAP_MARKER="/var/lib/discovery-net-bootstrap-v1"
readonly INSPECTOR_ENABLED="${inspector_enabled}"
readonly INSPECTOR_ADDRESS="${inspector_address}"
readonly INSPECTOR_TLS_MODE="${inspector_tls_mode}"
readonly ACME_EMAIL="${acme_email}"

export DEBIAN_FRONTEND=noninteractive

if [[ ! -f "$BOOTSTRAP_MARKER" ]]; then
  apt-get update
  apt-get install -y --no-install-recommends \
    ca-certificates curl git gnupg iproute2 jq python3 unattended-upgrades
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/debian/gpg \
    | gpg --dearmor --yes -o /etc/apt/keyrings/docker.gpg
  chmod 0644 /etc/apt/keyrings/docker.gpg
  # shellcheck source=/dev/null
  . /etc/os-release
  printf '%s\n' \
    "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $VERSION_CODENAME stable" \
    > /etc/apt/sources.list.d/docker.list
  apt-get update
  apt-get install -y --no-install-recommends \
    containerd.io \
    docker-buildx-plugin \
    docker-ce \
    docker-ce-cli \
    docker-compose-plugin
  printf '%s\n' \
    'APT::Periodic::Update-Package-Lists "1";' \
    'APT::Periodic::Unattended-Upgrade "1";' \
    > /etc/apt/apt.conf.d/20auto-upgrades
fi

for _attempt in $(seq 1 30); do
  [[ -b "$DATA_DEVICE" ]] && break
  sleep 2
done
[[ -b "$DATA_DEVICE" ]]

if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
  if wipefs --noheadings "$DATA_DEVICE" | grep -q . \
    || ! cmp -n 4194304 "$DATA_DEVICE" /dev/zero >/dev/null 2>&1; then
    echo "refusing to format non-empty data disk: $DATA_DEVICE" >&2
    exit 1
  fi
  mkfs.ext4 -F -m 0 -L discovery-data "$DATA_DEVICE"
fi

mkdir -p "$DATA_MOUNT"
DATA_UUID="$(blkid -s UUID -o value "$DATA_DEVICE")"
readonly DATA_UUID
if ! grep -q "^UUID=$DATA_UUID " /etc/fstab; then
  printf 'UUID=%s %s ext4 defaults,nofail,nodev,noexec,nosuid 0 2\n' \
    "$DATA_UUID" "$DATA_MOUNT" >> /etc/fstab
fi
mountpoint -q "$DATA_MOUNT" || mount "$DATA_MOUNT"

getent group "$SERVICE_GID" >/dev/null \
  || groupadd --system --gid "$SERVICE_GID" discovery-net
id -u discovery-net >/dev/null 2>&1 \
  || useradd --system --uid "$SERVICE_UID" --gid "$SERVICE_GID" \
    --home-dir "$DATA_MOUNT" --shell /usr/sbin/nologin discovery-net

install -d -o "$SERVICE_UID" -g "$SERVICE_GID" -m 0750 \
  "$DATA_MOUNT/cometbft-data" \
  "$DATA_MOUNT/ledger-data" \
  "$DATA_MOUNT/caddy-data" \
  "$DATA_MOUNT/caddy-config"
install -d -o root -g root -m 0750 /etc/discovery-net
install -o root -g root -m 0600 /dev/null /etc/discovery-net/infra.env
{
  printf 'INSPECTOR_ENABLED=%s\n' "$INSPECTOR_ENABLED"
  printf 'INSPECTOR_ADDRESS=%s\n' "$INSPECTOR_ADDRESS"
  printf 'INSPECTOR_TLS_MODE=%s\n' "$INSPECTOR_TLS_MODE"
  printf 'ACME_EMAIL=%s\n' "$ACME_EMAIL"
} > /etc/discovery-net/infra.env

systemctl enable --now docker
docker network inspect discovery-net-p2p >/dev/null 2>&1 \
  || docker network create --internal discovery-net-p2p
touch "$BOOTSTRAP_MARKER"

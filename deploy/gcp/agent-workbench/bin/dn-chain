#!/usr/bin/env bash
# What each agent has actually landed on the chain, and what the graph looks like.
set -euo pipefail
LEDGER=/scratch/discovery-net/node/ledger-data/artifact-ledger.sqlite
python3 - "$LEDGER" <<PY
import sqlite3, json, collections, subprocess, pathlib, sys
ledger = sys.argv[1]
keys = {}
for p in sorted(pathlib.Path("/opt/dn-agents/keys").glob("*.pem")):
    der = subprocess.run(["openssl","pkey","-in",str(p),"-pubout","-outform","DER"],
                         capture_output=True).stdout
    keys[der[-32:].hex()] = p.stem
con = sqlite3.connect(f"file:{ledger}?mode=ro", uri=True)
kinds, signers, total = collections.Counter(), collections.Counter(), 0
for (b,) in con.execute("select transaction_bytes from artifact_ledger_entries"):
    try: tx = json.loads(b)
    except Exception: continue
    for e in tx.get("envelopes", []):
        if "relation" in e.get("payload_type",""): continue
        total += 1
        sig = e.get("signer_public_key","")
        signers[keys.get(sig, sig[:12] + "… (other operator)")] += 1
        kinds[e.get("payload",{}).get("kind","?")] += 1
height = con.execute("select committed_height from artifact_ledger_state where singleton=1").fetchone()[0]
print(f"height {height}  ·  {total} contributions\n")
print("by signer:")
for k, n in signers.most_common(): print(f"  {k:<34} {n}")
print("\nby kind:")
for k, n in kinds.most_common(8): print(f"  {k:<22} {n}")
PY

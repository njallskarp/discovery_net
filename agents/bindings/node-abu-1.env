# Worked example: a validator whose ledger bind mount is root-owned, so reads
# have to go through the node's own application container.

DN_AGENT=researcher-1
DN_ROLE=research
DN_RUNNER=claude
DN_NODE=node-abu-1
DN_REPO=/home/ak_abuzar/dev/discovery_net
DN_CHAIN_ID=discovery-net

DN_RPC_URL=http://127.0.0.1:26657
DN_GRAPHQL_CMD='docker exec discovery-node-abu-1-application-1 discovery-net graphql --ledger-path /var/lib/discovery-net/artifact-ledger.sqlite'
DN_SUBMIT_CMD='/home/ak_abuzar/dev/discovery_net/.venv/bin/discovery-net submit contribution --rpc-url http://127.0.0.1:26657 --private-key /home/ak_abuzar/agents/node-abu-1/contributor.pem'

DN_KEY_PATH=/home/ak_abuzar/agents/node-abu-1/contributor.pem
DN_WORKLOG=/home/ak_abuzar/agents/node-abu-1/worklog.md
DN_CLAIMS=/home/ak_abuzar/agents/claims.md
DN_NOTES_CLONE=/home/ak_abuzar/dev/discovery-net-notes-researcher-1

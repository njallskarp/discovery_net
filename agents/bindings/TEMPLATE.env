# One binding = one agent bound to one node.
#
# This file is the ONLY place a node layout is described. The wrapper, the
# systemd units, and the prompt templates are identical for every operator, so
# bringing up a new fleet means writing bindings, not editing code.

DN_AGENT=                 # researcher-1 | researcher-2 | reviewer
DN_ROLE=                  # research | review   (selects the prompt template)
DN_RUNNER=                # claude | codex
DN_NODE=                  # node moniker, e.g. node-abu-1

# --- endpoints -------------------------------------------------------------
DN_RPC_URL=               # e.g. http://127.0.0.1:26657   (loopback only)

# How THIS node's committed ledger is read. Takes a GraphQL document as $1 and
# prints JSON on stdout. This is the field that differs most between operators.
#
#   direct (ledger readable by the agent user):
#     DN_GRAPHQL_CMD='/path/to/.venv/bin/discovery-net graphql --ledger-path /path/to/artifact-ledger.sqlite'
#
#   via container (ledger bind mount is root-owned):
#     DN_GRAPHQL_CMD='docker exec <container> discovery-net graphql --ledger-path /var/lib/discovery-net/artifact-ledger.sqlite'
DN_GRAPHQL_CMD=

# How a signed artifact is submitted from THIS node. The wrapper appends the
# --kind/--title/--body/--outgoing/--incoming arguments.
DN_SUBMIT_CMD=

# --- identity and state ----------------------------------------------------
DN_KEY_PATH=              # contributor PEM. Never read, printed, or copied.
DN_WORKLOG=               # append-only; the agent's memory between firings
DN_CLAIMS=                # shared claims file; the wrapper flocks it
DN_NOTES_CLONE=           # per-agent clone of the source-artifact repo
